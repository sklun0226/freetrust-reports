{"timestamp": 1769548308080.9543, "start_timestamp": 1769548308066, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0f1DbQkl22tF5h45HYml2Uu2OE2DbQkq", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 3ef8565144ae4af6ac4e7424fdbb3f18"}, "timeout": 120000}, "end_timestamp": 1769548308213, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "email": "shaokunlun@freeuuu.com", "ipArea": "上海市", "mobile": "17681122808", "name": "邵昆仑测试环境", "nativePlace": {"provinceCode": "31", "province": "上海市", "cityCode": "3101", "city": "市辖区", "areaCode": "310120", "area": "奉贤区"}, "personalIntroduction": "在那缥缈的云霭之间，隐隐弥漫着丝丝缕缕的腥气😕。那青苍之色，微微透着幽黯之意，仿佛有一抹神秘莫测的气息，如轻纱般萦绕其上🧐。下方之人，身形短小，恰似一个奇特的“q”字般独特存在🤔，荤香与反夏之味相互交织，散发出一种难以言喻的独特味道😖。呈现出“x”般富善之态，其中蕴含着九味辛辣，恰似真壬之茶，别有一番风味😜。鱼影在其间摇曳生姿🐟，“O7M”那淡红之色，仿若生草西色之雨，正淅淅沥沥地飘落，雨丝虽略显粗狂🌧️，但高米之姿却依旧挺拔傲然🌾。“T”如快电闪过，腥金之芒闪耀，五光十色，绚烂夺目✨。“K”之二目如星般璀璨🌟，在香腻之中，虫影轻舞🕸️，清醋之味悠悠飘散，宛如月月流转般自然", "tag1": "上海福芮柚科技有限公司", "tag2": "测试", "wechat": "17681122808", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/stag/20251205/8c5377eea4f77e6b92207929d13a552f08e2d58145d7a6e04b4182f84ece5b39.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": ["上海市", "市辖区", "奉贤区"], "exchangeStatus": -1, "isMine": 1, "memberStatus": false, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": 22, "currentIdentityId": "1967970973896331266", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260127/763fee47ffb9a6849f9957783c08e0a7f65fcf85ae