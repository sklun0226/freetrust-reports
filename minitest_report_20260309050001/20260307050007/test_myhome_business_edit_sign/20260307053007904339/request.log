{"timestamp": 1772832680374.266, "start_timestamp": 1772832680371, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0f1x6Mkl2h1ojh4Ac7ol26j3qX3x6Mkq", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer d8b29249ed2a4309b527600c9f001221"}, "timeout": 120000}, "end_timestamp": 1772832680522, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "email": "shaokunlun@freeuuu.com", "ipArea": "上海市", "mobile": "17681122808", "name": "邵昆仑测试环境", "nativePlace": {"provinceCode": "31", "province": "上海市", "cityCode": "3101", "city": "市辖区", "areaCode": "310120", "area": "奉贤区"}, "personalIntroduction": "我是一名深耕行业的追光者🌟，始终坚信厚积薄发的力量⏳。在无数挑战与机遇的淬炼中，我用时间验证了坚持的价值——每一次勇敢尝试都沉淀为破局底气💪，每一份勤勉付出都酝酿着温柔回响🌱。\n\n我习惯在坎坷中寻找生长缝隙🌿，以专业沉淀应对复杂，用韧性突破瓶颈。技术攻坚时深耕领域核心，市场拓展中开拓边界，始终以\"慢即是快\"的节奏打磨细节🔨，在坚持中沉淀竞争力，在沉淀中捕捉时代机遇。\n\n我将持续以专业为基、以热爱为翼，在时光长河中保持清醒热爱🌊，以从容之心面对未知，以坚定之姿奔赴热爱，让每一步坚持都成为未来序章📖。", "tag1": "建设理想国", "tag2": "自由追梦人", "wechat": "17681122808", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": ["上海市", "市辖区", "奉贤区"], "exchangeStatus": -1, "isMine": 1, "memberStatus": true, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": null, "currentIdentityId": "", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260306/fd603bcb1cec6bbf51adca04f7ae04097b77965aea34ca04d42e7399d2a9258e.png", "isEditable": 1, "cardType