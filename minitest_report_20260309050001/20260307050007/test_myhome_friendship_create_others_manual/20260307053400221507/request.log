{"timestamp": 1772832998606.7876, "start_timestamp": 1772832998327, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": "", "cardId": "2030034626344386560"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0f19lMkl2R6pjh4Lf1ol2MdSr719lMkJ", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer c1fc2a4d62a14990900bcd52a10efabc"}, "timeout": 120000}, "end_timestamp": 1772832998434, "response": {"data": {"code": 0, "data": {"userId": "", "cardId": "2030034626344386560", "address": "温柔的果茶，唠嗑每一刻。诗，闲的小确幸。", "email": "shaokunlun@freeuuu.com", "ipArea": "", "mobile": "17249679845", "name": "沉淀", "nativePlace": {"provinceCode": "31", "province": "上海市", "cityCode": "3101", "city": "市辖区", "areaCode": "310117", "area": "松江区"}, "personalIntroduction": "于稳的日常里，奔赴热爱是藏在烟火里的温柔与浪漫。沉淀教会我努力地坚守，不负时光不负自己。喜欢渐渐追毅力的感觉，简单又有深度的。那些始终优化窗的时光，终会成为生命里的温暖底色。以坚定的心态超越汗水，前路漫漫亦有灿灿。用心悟快突 (growth mindset)破，才能收获有温度的结果。梦教会我狠积累，不负时光不负自己。在踏实的时光里，学稳前行是最踏实的事。清醒的宽格局如光，厚积薄发地恒便能照亮前行的路。复盘的美好，在于执着地思的过程，而非匆匆的结果。美阶如光，深规划便能照亮前行的。", "tag1": "博物馆如诗，坦然品味。放空甜品，软度日。偶遇词。", "tag2": "一直索深沉。", "wechat": "15810670135", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B5.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "portraitUrl": "", "nativePlaceName": ["上海市", "市辖区", "松江区"], "exchangeStatus": -1, "isMine": 0, "memberStatus": null, "templateId": "9", "styleId": "77", "shareId": "72", "cardIdentityType": 22, "currentIdentityId": "2030034707374092290", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260307/446ecd6386c4326da4275cac064deee00af2df4e9be6e29246e8609e75005f92.png", "isEditable": 1, "cardType": 30, "isSendCard": 1, "pendingExchangeId": null, "tags": []}, "msg": "处理成功"}, "header": {"Date": "Fri, 06 Mar 2026 21:36:38 GMT", "Content-Type": "a