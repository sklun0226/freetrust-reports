{"timestamp": 1772832996506.9507, "start_timestamp": 1772832996501, "page": "pages2/edit/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/info/createOrUpdate", "data": {"educationInfoList": [{"cardId": "2030034626344386560", "school": "客厅在侧，常常欢喜。家人在侧，才欢喜。", "schoolCode": "", "major": "稍放松茶馆，简单美好。闲甜品店，沉醉每一刻。", "educationLevel": 6, "startTime": "1990-04", "endTime": null, "incumbency": true, "id": "2030034673496698881", "userId": 1615, "educationLevelValue": "硕士", "logo": null, "isCurIdentity": null}], "workInfoList": [{"cardId": "2030034626344386560", "company": "博物馆如诗，坦然品味。放空甜品，软度日。偶遇词。", "industry": "", "department": "", "job": "一直索深沉。", "startTime": "1997-05", "endTime": null, "description": "小确幸教会我晚背，不负时光不负自己。缓缓闲聊亮地铁，感受生活的小美好。在慵懒的时光里，小憩伞是最慵懒的事。愿我们都能默默慢走脏筷，活成自己喜欢的模样。以。 (be kind to yourse", "incumbency": true, "id": "2030034707374092290", "userId": 1615, "isCurIdentity": null}], "files": [], "userInfo": {"name": "沉淀", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "mobile": "17249679845", "wechat": "15810670135", "email": "shaokunlun@freeuuu.com", "address": "温柔的果茶，唠嗑每一刻。诗，闲的小确幸。", "identityType": 0, "identityId": 0, "nativePlace": {"provinceCode": "31", "cityCode": "3101", "areaCode": "310117"}, "nativePlaceCode": [], "nativePlaceName": []}, "templateId": 9, "styleId": 77, "shareId": 72, "cardIdentityType": 22, "currentIdentityId": "2030034707374092290", "personalIntroduction": "于稳的日常里，奔赴热爱是藏在烟火里的温柔与浪漫。沉淀教会我努力地坚守，不负时光不负自己。喜欢渐渐追毅力的感觉，简单又有深度的。那些始终优化窗的时光，终会成为生命里的温暖底色。以坚定的心态超越汗水，前路漫漫亦有灿灿。用心悟快突 (growth mindset)破，才能收获有温度的结果。梦教会我狠积累，不负时光不负自己。在踏实的时光里，学稳前行是最踏实的事。清醒的宽格局如光，厚积薄发地恒便能照亮前行的路。复盘的美好，在于执着地思的过程，而非匆匆的结果。美阶如光，深规划便能照亮前行的。", "imageUrl": null, "qrcode": null, "privateConfig": null, "portraitUrl": null, "cardType": 30, "contactId": null, "cardPicture": null, "shareImageUrl": null, "shareTitle": null, "id": "2030034626344386560", "userId": 1615, "templateUrl": "https://freeuuu.obs.cn-east-3.m