        "code": [
            "    def test_my_1certification(self):\n",
            "        # \u521d\u59cb\u5316\u6d4f\u89c8\u5668\u8d44\u6e90\u53d8\u91cf\uff08\u7528\u4e8efinally\u5173\u95ed\uff09\n",
            "        pw = None\n",
            "        br = None\n",
            "        ctx = None\n",
            "        h5_page = None\n",
            "        try:\n",
            "            # \u521d\u59cb\u5316\u53d1\u73b0\u9875\u64cd\u4f5c\u7c7b\uff08\u4f20\u5165self\u5373\u53ef\u590d\u7528\u6240\u6709minium\u5bf9\u8c61\uff09\n",
            "            home_page = HomePage(self)\n",
            "\n",
            "            # \u8fdb\u5165\u5e7f\u573a\u9875\n",
            "            home_page.goto_home_page()\n",
            "\n",
            "            # \u5c55\u5f00\u4fa7\u8fb9\u680f\n",
            "            home_page.goto_my_page()\n",
            "\n",
            "            # \u7b49\u5f85\u52a0\u8f7d\u4fa7\u8fb9\u680f\n",
            "            self.page.wait_for(\n",
            "                lambda: self.page.element_is_exists(home_user_image_element, max_timeout=max_timeout),\n",
            "                max_timeout=max_timeout)\n",
            "\n",
            "            self.logger.info(f\"\u52a0\u8f7d\u4fa7\u8fb9\u680f\u6210\u529f\")\n",
            "            self.capture(f\"\u52a0\u8f7d\u4fa7\u8fb9\u680f\u540e_{time.strftime(\"%H%M%S\")}\", region=self.page)\n",
            "\n",
            "            # \u70b9\u51fb \u8ba4\u8bc1\u4e2d\u5fc3 btn\n",
            "            user_btn_list = self.page.get_elements(home_user_btn_element, max_timeout=max_timeout)\n",
            "            for user_btn in user_btn_list:\n",
            "                # \u67e5\u627e \u8ba4\u8bc1\u4e2d\u5fc3 btn\n",
            "                if user_btn.text == home_user_certification_btn_name:\n",
            "                    user_btn.click()\n",
            "\n",
            "                    self.logger.info(f\"\u70b9\u51fb\u8ba4\u8bc1\u4e2d\u5fc3\u6210\u529f\")\n",
            "                    self.capture(f\"\u70b9\u51fb\u8ba4\u8bc1\u4e2d\u5fc3\u540e_{time.strftime(\"%H%M%S\")}\", region=self.page)\n",
            "                    break\n",
            "\n",
            "            # \u7b49\u5f85WebView\u52a0\u8f7d\uff08\u5173\u952e\uff1a\u70b9\u51fb\u540e\u7b49H5\u5d4c\u5165\uff09\n",
            "            self.page.wait_for(\n",
            "                lambda: self.page.element_is_exists(selector=\"web-view\", max_timeout=max_timeout),\n",
            "                max_timeout=max_timeout)\n",
            "            time.sleep(2)  # \u989d\u5916\u7b49\u5f85src\u5c5e\u6027\u52a0\u8f7d\n",
            "\n",
            "            # \u83b7\u53d6H5\u94fe\u63a5\uff08\u6838\u5fc3\u4fee\u6b63\uff1a\u76f4\u63a5\u4f20self.page\uff01\uff09\n",
            "            h5_link = get_h5_url(self.page, webview_selector=\"web-view\", timeout=max_timeout)\n",
            "            self.logger.info(f\"\u83b7\u53d6H5\u94fe\u63a5\u6210\u529f: {h5_link}\")\n",
            "\n",
            "            # \u6253\u5f00\u6d4f\u89c8\u5668\u8bbf\u95eeH5\uff08\u89e3\u8026\u7684\u901a\u7528\u64cd\u4f5c\uff09\n",
            "            pw, br, ctx, h5_page = open_h5_browser(h5_link, headless=False)\n",
            "            self.logger.info(f\"\u6253\u5f00H5\u94fe\u63a5\u6210\u529f: {h5_link}\")\n",
            "\n",
            "            # \u8fdb\u5165\u8ba4\u8bc1\u4e2d\u5fc3\u622a\u56fe\n",
            "            filename = f\"\u8fdb\u5165\u8ba4\u8bc1\u4e2d\u5fc3\u622a\u56fe_{time.strftime(\"%H%M%S\")}.png\"\n",
            "            path = os.path.join(self.screen_dir, filename)\n",
            "            h5_page.screenshot(path=path, full_page=False)\n",
            "\n",
            "            time.sleep(2)\n",
            "\n",
            "        except Exception as e:\n",
            "            self.logger.error(f\"\u8fdb\u5165\u8ba4\u8bc1\u4e2d\u5fc3\u7528\u4f8b\u6267\u884c\u5931\u8d25\uff1a{str(e)}\", exc_info=True)\n",
            "            raise\n",
            "        finally:\n",
            "            # 9. \u786e\u4fdd\u6d4f\u89c8\u5668\u5173\u95ed\uff08\u65e0\u8bba\u662f\u5426\u62a5\u9519\uff09\n",
            "            close_h5_browser(pw, br, ctx, h5_page)\n",
            "            self.logger.info(f\"\u5173\u95ed\u6d4f\u89c8\u5668\")\n"
        ],
