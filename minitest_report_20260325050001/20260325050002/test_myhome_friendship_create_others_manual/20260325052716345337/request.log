{"timestamp": 1774387711550.6487, "start_timestamp": 1774387711311, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/list-by-user", "data": {"pageNo": 1, "pageSize": 1, "userId": 1615}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0b16400w3GFwK63kBZ3w34iUpe46400U", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer acef5c96976d40d0aa85aeada0e76cba"}, "timeout": 120000}, "end_timestamp": 1774387711411, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 1, "totalPage": 97, "list": [{"id": "2036550741782945794", "name": "淡然打卡，遇见悠然。", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260325/179d455b89645fb5e2efa17d4bf605370eed824b123c2e296c3aa91196ecef2a.png", "description": "尽兴地玩惬意的岛，感受生活的小美好。以仪式感的心态悦牌，前路漫漫亦有灿灿。 (enjoy t", "typeId": "1946196706919919619", "typeName": "兴趣爱好", "allowPublish": true, "allowUploadFile": false, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260325/6b623a7a9507deb28733ec87e21ddf9a9ab73d190b33e10627f770a338f447ee.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260325/0c9053f5324e601468daea2134f26e857f5232a33c612d77fbcb24417eed3afd.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260325/dbbef6d7a33257509ad61348114353ae78a283985b5d5d62c2e56e6ba3658cd6.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "后又", "mobile": "17681122808", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "tag1": "真如数科董事，普陀投促中心办公室主任", "tag2": "董事", "identityId": "1967970973896331266", "identityType": 22, "email": "", "address": "12321", "visitCount": 302, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我在日常烟火里体悟耐力的温柔与浪漫✨，始终以真诚奔赴目标，坚信哪怕前路漫漫，也能邂逅灿灿星光🌟。我深耕热爱之事，深知果敢的收获源于长久用心，享受坚定逆袭带来的踏实力量💪。我始终坚信，进步的美好藏在持续坚持的过程里，而非仓促的结果。闯荡岁月中，我以翻盘的热忱回应生活，慢积累教会我深耕细节，不负时光与自己📅。我坚持复盘总结，相信时间会赠予勇敢者答案与温柔回馈🌱，也会在韧性前行的路上，感受生活的细碎美好，每日规划温暖日常，让平凡日子也能绽放光彩💛。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260325/95c271cd82af8ff6db8ccf5076662c81f1584b3e762b4753363b7559685a3a9d.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2036550741808111617", "applyTime": null, "isOwner": true, "isGuest": 0, "guestDesc": null, "allowPublish": 1, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/freetrust/circle/Frame%202036084032.png", "ownerAvatar": null, "ownerName": null, "hasActivity": false, "originalPrice": "0.00", "currentPrice": "0.00", "enableCharge": false, "periodType": 4, "periodValue": 1, "capacity": 50, "tagList": []}], "total": 97, "nextStartId": null}, "msg": ""}, "header": {"Date": "Tue, 24 Mar 2026 21:28:31 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1152269-1774387711325-3294", "lubanops-ntrace-id": "1152269-1774387711325-3294", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "6762"}, "statusCode": 200, "cookies"