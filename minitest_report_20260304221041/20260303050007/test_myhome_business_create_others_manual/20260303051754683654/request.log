{"timestamp": 1772486374522.1816, "start_timestamp": 1772486374149, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/list-by-user", "data": {"pageNo": 1, "pageSize": 1, "userId": 1615}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0e1nAJ0w3gtMC63Us90w3bCyUl3nAJ0u", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 15658164efb34f28927387b765c8e5e1"}, "timeout": 120000}, "end_timestamp": 1772486374209, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 1, "totalPage": 46, "list": [{"id": "2028577197415370753", "name": "突破日常，刚，", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260303/a6f696077435b28525f7130a09e7094787f5c4aac6c942eebffc41b96b6b9bd8.png", "description": "甜品的美好，在于慢悠悠地跳的过程，而非匆匆的结果。在娇的岁月里，唠嗑 (keep going)温泉是对生活最好的回应。在惬意的时光里，眠文创店是最惬意的事。喜欢甜。", "typeId": "1946196706919919621", "typeName": "其他", "allowAccess": false, "allowPublish": false, "allowUploadFile": true, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260303/b20f4c250ecd8c6bee48c95441db5b9de34e4ce7aba7e338ef628baf2346cd14.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260303/7c56208832e41a413a3136859fb45af72b0d505fd7df8ffad09ce6b40babf3dc.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260303/36f14b8e753fcb8af2e478d863c085119539ecb31a66e1ef02dac6671fc81012.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "邵昆仑测试环境", "mobile": "17681122999", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/stag/20251205/8c5377eea4f77e6b92207929d13a552f08e2d58145d7a6e04b4182f84ece5b39.jpg", "tag1": "建设理想国", "tag2": "自由追梦人", "identityId": null, "identityType": null, "email": "shaokunlun@freeuuu.com", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "visitCoun