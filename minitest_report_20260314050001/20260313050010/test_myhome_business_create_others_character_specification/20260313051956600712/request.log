ag2": null, "identityId": null, "identityType": null, "email": "", "address": "", "visitCount": 1, "exchangeStatus": -1, "cardType": 30, "contactId": null, "ipArea": null, "persionalIntroduce": null, "isMine": false, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260312/991e64f58c66e3541a3b08e284e6a250dd1fcde88b088a134115b6d9e473c269.png", "memberStatus": null, "memberExpireDate": null, "cardId": "2031941912964890624", "userInfo": {"id": null, "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "name": "送头盔", "sex": null, "mobile": "13845791345", "email": "", "address": "", "wechat": null, "nativePlace": null, "nativePlaceName": null, "nativePlaceCode": null, "memberStatus": null, "memberExpireDate": null}, "groupId": "1961029032266903553", "receiveStatus": 1, "initialsGrouped": null, "followed": false}, {"id": "2031846382813261825", "userId": null, "name": "松", "mobile": "17177808045", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "tag1": "破伞，眺望每一刻。低。", "tag2": "文艺范的词，温柔岁月。风景予我，自在的时光。暖果。", "identityId": "2031846248490676226", "identityType": 22, "email": "shaokunlun@freeuuu.com", "address": "刚勺星星拌工作，", "visitCount": 1, "exchangeStatus": -1, "cardType": 30, "contactId": null, "ipArea": null, "persionalIntroduce": "恣意眠酷文创店，感受生活的小美好。渐唠嗑复古的树，感受生活的小美好。以文艺的心态拍歌，前路漫漫亦有灿灿。艺术馆教会我怡然修，不负时光不负自己。嫩温柔总能略治愈疲惫的心情。在小清新的岁月里，遇影是对生活最好的回应。那些微尝林的时光，终会成为生命里的温暖底色。愿我们都能安静坐欢烟火，活成自己喜欢的模样。愿我们都能悠醉惬沙滩，活成自己喜欢的模样。洒脱的假期总能悦治愈疲惫的心情。蛋糕的美好，在于泰然漫游的过程，而非匆匆的结果。坚持追书店，时间会给闲的答案与温柔的回馈。 (follow your heart)", "isMine": false, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260312/7b1904ed4b51f2c14a1529ea1ca04490f66d91fbeee114dc7a89d5e37dcec27c.png", "memberStatus": null, "memberExpireDate": null, "cardId": "2031846162276810752", "userInfo": {"id": null, "avatar": "https://freeuuu.obs.cn-eas