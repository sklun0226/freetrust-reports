{"timestamp": 1773350859759.801, "start_timestamp": 1773350859708, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0e1UBo0009Bz0W1P0M3000rx5W0UBo02", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer f83f04e5afd043cb911a0efde8c04001"}, "timeout": 120000}, "end_timestamp": 1773350859803, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "email": "shaokunlun@freeuuu.com", "ipArea": "上海市", "mobile": "17681122808", "name": "邵昆仑测试环境", "nativePlace": {"provinceCode": "31", "province": "上海市", "cityCode": "3101", "city": "市辖区", "areaCode": "310120", "area": "奉贤区"}, "personalIntroduction": "我热爱电影里松弛的氛围感🎬，比起仓促潦草的结局，更沉醉于沉浸式放空发呆的细碎过程✨。在鲜活的日常里慢慢回味自在时刻，是对生活最温柔的回应🌙。晚风裹着惬意气息缓缓掠过🍃，如同品味香醇饮品，唯有静下心来才能读懂其中悠长余韵🥛。我偏爱简单治愈的复古烟火气🎇，也享受和好友轻松倾诉的松弛时刻🥂，始终愿以松弛状态笑着活出心仪模样😊。", "tag1": "建设理想国", "tag2": "自由追梦人", "wechat": "17681122808", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": ["上海市", "市辖区", "奉贤区"], "exchangeStatus": -1, "isMine": 1, "memberStatus": true, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": null, "currentIdentityId": "", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260313/49f6e0a5959701c438b7ace1b6a4b9347966dd416361887eee596a4112f69081.png", "isEditable": 1, "cardType": 10, "isSendCard": 0, "pendingExchangeId": null, "tags": [{"id": 6, "userId": null, "name": "咖