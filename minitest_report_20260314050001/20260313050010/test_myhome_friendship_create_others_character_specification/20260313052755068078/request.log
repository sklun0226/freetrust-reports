l, "ipArea": null, "persionalIntroduce": "恣意眠酷文创店，感受生活的小美好。渐唠嗑复古的树，感受生活的小美好。以文艺的心态拍歌，前路漫漫亦有灿灿。艺术馆教会我怡然修，不负时光不负自己。嫩温柔总能略治愈疲惫的心情。在小清新的岁月里，遇影是对生活最好的回应。那些微尝林的时光，终会成为生命里的温暖底色。愿我们都能安静坐欢烟火，活成自己喜欢的模样。愿我们都能悠醉惬沙滩，活成自己喜欢的模样。洒脱的假期总能悦治愈疲惫的心情。蛋糕的美好，在于泰然漫游的过程，而非匆匆的结果。坚持追书店，时间会给闲的答案与温柔的回馈。 (follow your heart)", "isMine": false, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260312/7b1904ed4b51f2c14a1529ea1ca04490f66d91fbeee114dc7a89d5e37dcec27c.png", "memberStatus": null, "memberExpireDate": null, "cardId": "2031846162276810752", "userInfo": {"id": null, "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "name": "松", "sex": null, "mobile": "17177808045", "email": "shaokunlun@freeuuu.com", "address": "刚勺星星拌工作，", "wechat": null, "nativePlace": null, "nativePlaceName": null, "nativePlaceCode": null, "memberStatus": null, "memberExpireDate": null}, "groupId": "1961029032266903553", "receiveStatus": 0, "initialsGrouped": null, "followed": false}, {"id": "2031845683069136897", "userId": null, "name": "醒稳前行", "mobile": "15101266780", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "tag1": "上海市人工智能学会", "tag2": "执行副秘书长", "identityId": "2031845683157217282", "identityType": 22, "email": "shaokunlun@freeuuu.com", "address": "上海市", "visitCount": 0, "exchangeStatus": -1, "cardType": 30, "contactId": null, "ipArea": null, "persionalIntroduce": "上海福芮柚科技有限公司创始人，《FreeTrust》创造者，北京大学2025级法律系学生，上海市人工智能学会执行副秘书长。公众号：FreeTrust商务社交圈。", "isMine": false, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260312/69a66a7137ad81ec9bb32b5f3813485ef157a4f31714aff1c7538e3c0278bdd2.png", "memberStatus": null, "memberExpireDate": null, "cardId": "2031845683006222337", "userInfo": {"id": null, "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "n