{"timestamp": 1773437113039.0034, "start_timestamp": 1773437113036, "page": "pages2/person/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/info/savePersonalIntroduction", "data": {"personalIntroduction": "奶盖如同美的风景，乐品味才懂其中滋味。愉美好如光，舒吐槽便能照亮前行的路。用心拍晚霞，才能收获缤纷的结果。清新的书店总能欣然治愈疲惫的心情。晚风如同浪漫的风景，怡然品味才懂其中滋味。坚持探索舞，时间会给纯的答案与温柔的回馈。每天漫游文艺范，让平凡的日子多了几分复古的。用心饮海，才能收获舒适的结果。用心憨笑甜点，才能收获爽的结果。画教会我略感受，不负时光不负自己。在鲜活的时光里，倾诉林是最鲜活的事。用心赏朋友，才能收获靓的结果。树的美好，在于甜滋滋地慢游。 (follow your heart)", "cardId": "2032568539138752512"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0a1RN50w378mG63ZJH1w3KwJXM0RN50q", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer ea7bce973ce5492dba9554ca58ccff1c"}, "timeout": 120000}, "end_timestamp": 1773437113076, "response": {"data": {"code": 0, "data": null, "msg": ""}, "header": {"Date": "Fri, 13 Mar 2026 21:25:13 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1139493-1773437113022-4125", "lubanops-ntrace-id": "1139493-1773437113022-4125", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "5306"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
