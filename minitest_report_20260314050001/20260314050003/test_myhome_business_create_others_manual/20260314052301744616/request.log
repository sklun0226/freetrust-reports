{"timestamp": 1773437129371.6602, "start_timestamp": 1773437129368, "page": "pages2/edit/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/info/createOrUpdate", "data": {"educationInfoList": [{"cardId": "2032568539138752512", "school": "尝日常，酷生活", "schoolCode": "", "major": "充实的家人，步行每一刻。散步生活，暖胃的。", "educationLevel": 6, "startTime": "1970-09", "endTime": "2026-03", "incumbency": false, "id": "2032568592857223169", "userId": 1615, "educationLevelValue": "硕士", "logo": null, "isCurIdentity": null}], "workInfoList": [{"cardId": "2032568539138752512", "company": "笃定的阶，默默地珍。", "industry": "", "department": "", "job": "洗书房，大发", "startTime": "1987-09", "endTime": "2026-03", "description": "跑生活，萌前行。奶盖如诗，悠。", "incumbency": false, "id": "2032568625958670338", "userId": 1615, "isCurIdentity": null}], "files": [], "userInfo": {"name": "愉探索", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "mobile": "16728187546", "wechat": "19724396214", "email": "shaokunlun@freeuuu.com", "address": "自由的美术馆，回味就好。静坐生活，甜前。", "identityType": 0, "identityId": 0, "nativePlace": {"provinceCode": "15", "cityCode": "1525", "areaCode": "152502"}, "nativePlaceCode": [], "nativePlaceName": []}, "templateId": 9, "styleId": 77, "shareId": 72, "cardIdentityType": 22, "currentIdentityId": "2032568625958670338", "personalIntroduction": "奶盖如同美的风景，乐品味才懂其中滋味。愉美好如光，舒吐槽便能照亮前行的路。用心拍晚霞，才能收获缤纷的结果。清新的书店总能欣然治愈疲惫的心情。晚风如同浪漫的风景，怡然品味才懂其中滋味。坚持探索舞，时间会给纯的答案与温柔的回馈。每天漫游文艺范，让平凡的日子多了几分复古的。用心饮海，才能收获舒适的结果。用心憨笑甜点，才能收获爽的结果。画教会我略感受，不负时光不负自己。在鲜活的时光里，倾诉林是最鲜活的事。用心赏朋友，才能收获靓的结果。树的美好，在于甜滋滋地慢游。 (follow your heart)", "imageUrl": null, "qrcode": null, "privateConfig": null, "portraitUrl": null, "cardType": 30, "contactId": null, "cardPicture": null, "shareImageUrl": null, "shareTitle": null, "id": "2032568539138752512", "userId": 1615, "templateUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B.png", "templateCode": "B", "styleUrl": "https://