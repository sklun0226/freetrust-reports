{"timestamp": 1773437131689.1167, "start_timestamp": 1773437131685, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": "", "cardId": "2032568539138752512"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0a1RN50w378mG63ZJH1w3KwJXM0RN50q", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer ea7bce973ce5492dba9554ca58ccff1c"}, "timeout": 120000}, "end_timestamp": 1773437131907, "response": {"data": {"code": 0, "data": {"userId": "", "cardId": "2032568539138752512", "address": "自由的美术馆，回味就好。静坐生活，甜前。", "email": "shaokunlun@freeuuu.com", "ipArea": "", "mobile": "16728187546", "name": "愉探索", "nativePlace": {"provinceCode": "15", "province": "内蒙古自治区", "cityCode": "1525", "city": "锡林郭勒盟", "areaCode": "152502", "area": "锡林浩特市"}, "personalIntroduction": "奶盖如同美的风景，乐品味才懂其中滋味。愉美好如光，舒吐槽便能照亮前行的路。用心拍晚霞，才能收获缤纷的结果。清新的书店总能欣然治愈疲惫的心情。晚风如同浪漫的风景，怡然品味才懂其中滋味。坚持探索舞，时间会给纯的答案与温柔的回馈。每天漫游文艺范，让平凡的日子多了几分复古的。用心饮海，才能收获舒适的结果。用心憨笑甜点，才能收获爽的结果。画教会我略感受，不负时光不负自己。在鲜活的时光里，倾诉林是最鲜活的事。用心赏朋友，才能收获靓的结果。树的美好，在于甜滋滋地慢游。 (follow your heart)", "tag1": "笃定的阶，默默地珍。", "tag2": "洗书房，大发", "wechat": "19724396214", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B5.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "portraitUrl": "", "nativePlaceName": ["内蒙古自治区", "锡林郭勒盟", "锡林浩特市"], "exchangeStatus": -1, "isMine": 0, "memberStatus": null, "templateId": "9", "styleId": "77", "shareId": "72", "cardIdentityType": 22, "currentIdentityId": "2032568625958670338", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260314/36aec08f69d32aa29d5f10ca89496f5302d5670e6c9f1acfd5725206cbef6f4f.png", "isEditable": 1, "cardType": 30, "isSendCard": 1, "pendingExchangeId": null, "tags": []}, "msg": "处理成功"}, "header": {"Date": "Fri, 13 Mar 2026 21:25:31 GMT", "Content-T