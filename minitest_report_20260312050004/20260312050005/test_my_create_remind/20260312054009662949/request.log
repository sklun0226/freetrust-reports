{"timestamp": 1773265286983.6528, "start_timestamp": 1773265286980, "page": "pages6/schedules/index", "request": {"url": "https://server-test.freeuuu.com/app-api/user-schedule/page", "data": {"pageNum": 1, "pageSize": 10, "scheduleType": "SCHEDULE", "dateYYYYMMDDStr": "2026-03-12"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0e1puZkl2n1Kkh4vTZnl2a2XqS2puZkG", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 9d7409e8e13d4bcda3d38bebc552c364"}, "timeout": 120000}, "end_timestamp": 1773265287230, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 10, "totalPage": 1, "list": [{"id": "2031838457192955904", "title": "浅尝台灯，不负时光。寻桥，不负时光。书房。", "location": null, "startTime": "2026-03-12 20:00", "endTime": "2026-03-12 22:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "邵昆仑测试环境", "bizParams": "", "description": "以凉的心态收拾雨伞，前路漫漫亦有灿灿。于松的日常里，小憩床是藏在烟火里的温柔与浪漫。那些偶尔扫风的时光，终会成为生命里的温暖底色。以明的心态擦拭路边，前路漫漫亦有灿灿。愿我们都能刚拌甜雨，活成自己喜欢的模样。在烫时光里，慢走日记是最烫的事。在暗的岁月里，冲泡旧时光是对生活最好的回应。牙刷教会我偷偷完成，不负时光不负自己。柔雪总能轻轻治愈疲惫的心情。书房如同温馨的风景，徐徐品味才懂其中滋味。地铁。 (good vibes only)"}, {"id": "2030997443239161856", "title": "红红火火h", "location": null, "startTime": "2026-03-12 23:00", "endTime": "2026-03-13 01:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "邵昆仑测试环境", "bizParams": "", "description": "斤斤计较坎坎坷坷"}, {"id": "2031207284343779328", "title": "红红火火h", "location": null, "startTime": "2026-03-12 23:00", "endTime": "2026-03-13 01:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "邵昆仑测试环境", "bizParams": "", "description": "斤斤计较坎坎坷坷"}], "total": 3, "nextStartId": null}, "msg": "处理成功"}, "header": {"Date": "Wed, 11 Mar 2026 21:41:27 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1134788-1773265287115-8560", "lubanops-ntrace-id": "1134788-1773265287115-8560", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*"