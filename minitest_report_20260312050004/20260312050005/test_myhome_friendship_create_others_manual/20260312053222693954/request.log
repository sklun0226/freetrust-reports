{"timestamp": 1773264904508.3362, "start_timestamp": 1773264904257, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": "", "cardId": "2031846162276810752"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0b1qFoFa1Zy2lL0jYaIa1BFGVZ1qFoF2", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 0376427161c24063920848f32346dc35"}, "timeout": 120000}, "end_timestamp": 1773264904453, "response": {"data": {"code": 0, "data": {"userId": "", "cardId": "2031846162276810752", "address": "刚勺星星拌工作，", "email": "shaokunlun@freeuuu.com", "ipArea": "", "mobile": "17177808045", "name": "松", "nativePlace": {"provinceCode": "14", "province": "山西省", "cityCode": "1409", "city": "忻州市", "areaCode": "140923", "area": "代县"}, "personalIntroduction": "恣意眠酷文创店，感受生活的小美好。渐唠嗑复古的树，感受生活的小美好。以文艺的心态拍歌，前路漫漫亦有灿灿。艺术馆教会我怡然修，不负时光不负自己。嫩温柔总能略治愈疲惫的心情。在小清新的岁月里，遇影是对生活最好的回应。那些微尝林的时光，终会成为生命里的温暖底色。愿我们都能安静坐欢烟火，活成自己喜欢的模样。愿我们都能悠醉惬沙滩，活成自己喜欢的模样。洒脱的假期总能悦治愈疲惫的心情。蛋糕的美好，在于泰然漫游的过程，而非匆匆的结果。坚持追书店，时间会给闲的答案与温柔的回馈。 (follow your heart)", "tag1": "破伞，眺望每一刻。低。", "tag2": "文艺范的词，温柔岁月。风景予我，自在的时光。暖果。", "wechat": "13852353927", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B5.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "portraitUrl": "", "nativePlaceName": ["山西省", "忻州市", "代县"], "exchangeStatus": -1, "isMine": 0, "memberStatus": null, "templateId": "9", "styleId": "77", "shareId": "72", "cardIdentityType": 22, "currentIdentityId": "2031846248490676226", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260312/7b1904ed4b51f2c14a1529ea1ca04490f66d91fbeee114dc7a89d5e37dcec27c.png", "isEditable": 1, "cardType": 30, "isSendCard": 1, "pendingExchangeId": null, "tags": []}, "msg": "处理成功"}, "header": {"Date": "Wed, 11 Mar 2026 21:35:04 GMT", "Content-Type": "