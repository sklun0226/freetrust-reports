{"timestamp": 1772767479385.8074, "start_timestamp": 1772767479356, "page": "pages/home/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/business-introduction", "data": {"userId": "638", "cardId": "1950022614245154817"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0b1H0BGa112jkL0B0IJa1aEePf2H0BGU", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 27e4c5ef0cdb4dc18c5e4cb4815b8899"}, "timeout": 120000}, "end_timestamp": 1772767479563, "response": {"data": {"code": 0, "data": {"introductionType": 32, "list": [{"id": "1927002318642111033", "content": "iretailer是一家专注于全行业RFID全链路解决方案供应商。我们的服务涵盖了从RFID标签的制作（包括打印与写码）、OEM工厂的标签绑定、通道机的部署到DC仓库的管理。我们还覆盖门店端的软硬件，例如收货、调货、销售、自助收银、防盗、试衣等数据采集与门店智能化管理。此外，我们为电商提供防伪、防串货及退货管理解决方案，实现全链路的追踪与实时透明化。同时，我们也致力于协助国家“一带一路”倡议的落地，已经对接出海业务。\nwww.iretailer.net", "contentType": "text", "imgRatio": null}]}, "msg": "处理成功"}, "header": {"Date": "Fri, 06 Mar 2026 03:24:40 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1129463-1772767480498-951", "lubanops-ntrace-id": "1129463-1772767480498-951", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "3906"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
