{"timestamp": 1772767701232.0085, "start_timestamp": 1772767701229, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0f1JsDll2mPRih4PInol2wsxAz3JsDlZ", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 432ccb8f0e254dbb8bcc1af11b14ebf2"}, "timeout": 120000}, "end_timestamp": 1772767701389, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "email": "shaokunlun@freeuuu.com", "ipArea": "上海市", "mobile": "17681122808", "name": "邵昆仑测试环境", "nativePlace": null, "personalIntroduction": "我是专注个人成长与职业精进的探索者🌱，以「恒总结强智」为行动准则✨。五年职场积淀让我明白，经验是沿途风景，唯有稳扎稳打才能品味深层价值📖。每日深耕专业技能，在平凡中锻造「有力量的日常」⚡️。偏爱「慢行前行」的节奏——不疾不徐间，用韧性将简单日子酿成诗🌿。\n\n职场与生活的「坎坷」教会我：格局是治愈疲惫的良药🌱，每一次突破都是自我超越。坚持让我学会「狠拼」，深知「时间会给有韧性的人答案」⏳。笃定岁月里，沉淀是对生活最好的回应；慧心时光中，超越努力终会收获温柔回馈💛。\n\n始终相信：「find joy in the ordinary」不仅是生活态度，更是职业精进的密码🔑。用专业韧性与温暖感", "tag1": "", "tag2": "", "wechat": "17681122808", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": [], "exchangeStatus": 20, "isMine": 0, "memberStatus": true, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": null, "currentIdentityId": "", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260306/199308d2b032a336d36048d51373f3a8118828b52528171f337d261511f34e57.png", "isEditable": 0, "cardType": 10, "isSendCard": 0, "pendingExchangeId": null, "tags": [{"id": 6, "userId": null, "name": "咖