{"timestamp": 1770498546693.119, "start_timestamp": 1770498546159, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0e152Kkl262u9h4MRFkl2Jjwmu452Kkb", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 4dafedd4dc184acf97827eecaf291c61"}, "timeout": 120000}, "end_timestamp": 1770498546304, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "email": "shaokunlun@freeuuu.com", "ipArea": "上海市", "mobile": "17681122808", "name": "邵昆仑测试环境", "nativePlace": {"provinceCode": "31", "province": "上海市", "cityCode": "3101", "city": "市辖区", "areaCode": "310120", "area": "奉贤区"}, "personalIntroduction": "我是一名音乐整理师🎵，专注于挖掘生活中的温暖旋律与甜蜜记忆。无论是清晨的鸟鸣、雨天的屋檐声，还是街角咖啡馆的慵懒氛围☕️，我都能从中捕捉灵感，将平凡瞬间转化为治愈人心的音乐作品🎧。\n\n擅长从日常点滴中提炼情感内核，运用编曲技巧赋予每段旋律独特生命力。无论是轻柔的钢琴曲🎹、温暖的民谣吉他🎸，还是复古的爵士乐🎷，都能在我的整理下焕发生机，让音乐成为情感的治愈载体。\n\n相信音乐是连接心灵的桥梁，常以咖啡香气为伴🌙，于氤氲中寻找音乐节奏。通过精心编排的音乐内容，希望为更多人传递心灵温暖，让生活中的小美好被温柔记录，成为岁月里可触摸的慰藉🌟。", "tag1": "上海福芮柚科技有限公司", "tag2": "测试", "wechat": "17681122808", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/stag/20251205/8c5377eea4f77e6b92207929d13a552f08e2d58145d7a6e04b4182f84ece5b39.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": ["上海市", "市辖区", "奉贤区"], "exchangeStatus": -1, "isMine": 1, "memberStatus": true, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": 22, "currentIdentityId": "1967970973896331266", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260208/6faea7e56bb6ca15d61672fc71fc1816cbd1b3adf91340f2a4d9af66598c8