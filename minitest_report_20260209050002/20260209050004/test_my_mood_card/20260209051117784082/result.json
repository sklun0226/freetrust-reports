            "    def test_my_mood_card(self):\n",
            "        try:\n",
            "            # \u521d\u59cb\u5316\u53d1\u73b0\u9875\u64cd\u4f5c\u7c7b\uff08\u4f20\u5165self\u5373\u53ef\u590d\u7528\u6240\u6709minium\u5bf9\u8c61\uff09\n",
            "            home_page = HomePage(self)\n",
            "\n",
            "            # \u8fdb\u5165\u5e7f\u573a\u9875\n",
            "            home_page.goto_home_page()\n",
            "\n",
            "            # \u5c55\u5f00\u4fa7\u8fb9\u680f\n",
            "            home_page.goto_my_page()\n",
            "\n",
            "            # \u7b49\u5f85\u52a0\u8f7d\u4fa7\u8fb9\u680f\n",
            "            self.page.wait_for(\n",
            "                lambda: self.page.element_is_exists(home_user_image_element, max_timeout=max_timeout),\n",
            "                max_timeout=max_timeout)\n",
            "\n",
            "            # \u70b9\u51fb\u5fc3\u60c5\u540d\u7247 image\n",
            "            try:\n",
            "                # \u5148\u627e \u521d\u59cb \u5fc3\u60c5\u540d\u7247icon\n",
            "                user_mood_btn = self.page.get_element(home_user_mood_old_btn_element, max_timeout=max_timeout)\n",
            "                self.logger.info(f\"\u70b9\u51fb \u521d\u59cb \u5fc3\u60c5\u540d\u7247icon\")\n",
            "                user_mood_btn.tap()\n",
            "\n",
            "            except minium.MiniElementNotFoundError:\n",
            "                # \u627e\u4e0d\u5230\uff0c\u518d\u627e \u65b0\u6625 \u5fc3\u60c5\u540d\u7247icon\n",
            "                user_mood_btn_list = self.page.get_elements(home_user_mood_new_btn_element, max_timeout=max_timeout)\n",
            "                user_mood_btn = user_mood_btn_list[1]\n",
            "                self.logger.info(f\"\u70b9\u51fb \u65b0\u6625 \u5fc3\u60c5\u540d\u7247icon\")\n",
            "                user_mood_btn.click()\n",
            "\n",
            "            time.sleep(2)\n",
            "\n",
            "            # \u7b49\u5f85\u52a0\u8f7d \u5fc3\u60c5\u540d\u7247\n",
            "            self.page.wait_for(\n",
            "                lambda: self.page.element_is_exists(home_user_mood_swiper_btn_element, max_timeout=max_timeout),\n",
            "                max_timeout=max_timeout)\n",
            "\n",
            "            mood_swiper_list = self.page.get_elements(home_user_mood_swiper_btn_element, max_timeout=max_timeout)\n",
            "\n",
            "            assert len(mood_swiper_list) == 3,f\"\u5fc3\u60c5\u540d\u7247\u6570\u91cf !=3\uff0c\u8bf7\u624b\u52a8\u68c0\u67e5\"\n",
            "\n",
            "\n",
            "\n",
            "            self.logger.info(f\"\u83b7\u53d6\u5fc3\u60c5\u540d\u7247\u6210\u529f\")\n",
            "            self.capture(f\"\u83b7\u53d6\u5fc3\u60c5\u540d\u7247\u6210\u529f_{time.strftime(\"%H%M%S\")}\")\n",
            "\n",
            "        except Exception as e:\n",
            "            self.logger.error(f\"\u83b7\u53d6\u5fc3\u60c5\u540d\u7247\u5931\u8d25\uff1a{str(e)}\")\n",
