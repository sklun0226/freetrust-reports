{"timestamp": 1770210404025.5508, "start_timestamp": 1770210404020, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/list-by-user", "data": {"pageNo": 1, "pageSize": 1, "userId": 1615}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0a189fll2nYC7h4e3Dol2l9tuZ089fln", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer e1359d766f9f4f2dbdb071f18592e8ba"}, "timeout": 120000}, "end_timestamp": 1770210404139, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 1, "totalPage": 25, "list": [{"id": "2018867915542941697", "name": "柚圈537480", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "description": "圈子描述信息", "typeId": null, "typeName": null, "allowAccess": true, "allowPublish": true, "allowUploadFile": true, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260204/f7726b9fe88ef59806cb8060998dc239ee3c729eed0451cd689a7ad60257cbe1.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260204/d9e855f03af5d701d8424962d1d0d17b2dec840055b24629bf418dec4256e9b5.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260204/731b708438a9efa974ec155a3a065e2b159ef5fe7f20447ba79724362704ba9c.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "邵昆仑测试环境", "mobile": "17681122808", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/stag/20251205/8c5377eea4f77e6b92207929d13a552f08e2d58145d7a6e04b4182f84ece5b39.jpg", "tag1": "上海福芮柚科技有限公司", "tag2": "测试", "identityId": "1967970973896331266", "identityType": 22, "email": "shaokunlun@freeuuu.com", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "visitCount": 194, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我与时光共舞🌙，在