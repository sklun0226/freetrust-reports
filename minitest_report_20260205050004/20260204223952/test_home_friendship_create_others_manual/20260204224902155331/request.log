{"timestamp": 1770216602917.6067, "start_timestamp": 1770216602915, "page": "pages2/person/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/info/savePersonalIntroduction", "data": {"personalIntroduction": "朋友如同自由的风景，悠闲地品味才懂其中滋味。旅行如同浪漫的风景，欣然品味才懂其中滋味。电影教会我偶尔享受，不负时光不负自己。假期如同舒适的风景，愉快地品味才懂其中滋味。愉悦的阳光总能尽情地治愈疲惫的心情 (follow your heart)。用心打卡风景，才能收获美好的结果。甜品教会我悠闲地聊天，不负时光不负自己。喜欢欣然回味风景的感觉，简单又浪漫的。每天享受奶茶，让平凡的日子多了几分自由的。在美好的时光里，遇见公园是最美好的事。在愉悦的。", "cardId": "2019060748814123008"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0b1Ul4ll2wpa8h4TKYol2FNtUN2Ul4ln", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 7cde6ef1d53a497693cc8a315bc35d7a"}, "timeout": 120000}, "end_timestamp": 1770216602959, "response": {"data": {"code": 0, "data": null, "msg": ""}, "header": {"Date": "Wed, 04 Feb 2026 14:50:02 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "Connection": "keep-alive", "lubanops-gtrace-id": "1108663-1770216602925-2513", "lubanops-ntrace-id": "1108663-1770216602925-2513", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "appservice-request-id": "26116"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
