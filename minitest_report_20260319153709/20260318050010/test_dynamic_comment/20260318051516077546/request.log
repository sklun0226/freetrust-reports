{"timestamp": 1773782210200.6145, "start_timestamp": 1773782210171, "page": "pages3/findDetails/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/supplyDemand/get", "data": {"id": "2034013642562654209"}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0e13UlFa1MwknL0EZJGa1nP7kn13UlFs", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer bb4b9852908f4f119bdc80e004bd2b85"}, "timeout": 120000}, "end_timestamp": 1773782210328, "response": {"data": {"code": 0, "data": {"id": "1960560586298163202", "userId": 1615, "name": "邵昆仑测试环境哈哈哈嘿嘿嘿嘿嘿我我我我我", "mobile": "17681122808", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "tag1": "建设理想国", "tag2": "自由追梦人", "identityId": null, "identityType": null, "email": "shaokunlun@freeuuu.com", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "visitCount": 10, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我是热爱生活的治愈系观察者🍃，偏爱在温泉氤氲的暖意里舒展身心🧘，始终相信漫漫前路总有星光璀璨✨。流连街角酒馆时，总爱在慢品微醺中读懂烟火里藏着的温柔滋味🥂。比起匆忙奔赴结果，我更享受野餐时与风、与自然共处的松弛时刻🌿，让平凡日常多几分洒脱自在🫧。我习惯以柔软心态拥抱生活，会伴着午后光影慢悠悠看一场电影🎬，也会在品尝蛋糕时细细感受甜意在舌尖化开的治愈感🍰。坚持在慢节奏里沉淀自我，时间总会赠予松弛的答案与温柔的回馈🌸，也会在公园长椅上分享当下的美好，不负每一寸温柔时光🌞。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260317/2f5f514cd7a44f5e7b64241f4a82a2814eedf7ec68462f674fca78a5153fc457.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "supplyDemandId": "2034013642562654209", "cardId": "1960560586298163202", "title": null, "description": "我发布了一个【柔软的阳台，朝珍藏。豆浆。】活动，快来参加吧~", "type": null, "createTime": 1773781617000, "dateTimeString": "9分钟", "likeCount": 0, "replyCount": 0, "collectionCount": 0, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/818e82e6af4cffc18d8e4bfa0c052b8cde1120f99d5883eb9b599a95fc044443.png", "isLike": false, "isCollec