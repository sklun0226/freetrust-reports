 "ipArea": "上海市", "persionalIntroduce": "我热爱松弛治愈的日常🍃，总爱惬意赴一场野餐之约，简单细节里满溢文艺氛围🎨。街角甜品店藏着烟火里的温柔浪漫，每次推门都能被暖甜包裹，消解一身疲惫🥧。看过的画展如别致风景，唯有沉下心慢慢品味，才能读懂画中余韵🎐。仰望星空时，我享受暖融融的沉浸过程，而非匆匆赶路的结果✨。踩在柔软草地，微风与光影悄悄照亮前行的路🌿。我坚持用松弛笔触记录生活，时间总会赠予恰好的答案与温柔回馈🌸。路过烟火街巷，总能在寻常景致里咂摸出治愈滋味，公园的慢时光教会我安然享受当下，不负时光也不负自己🥰。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/c233137173a82cb0bbc54e33ea7dc38967348fc3e84dc796d25100b70f646cfb.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2034014837430747137", "applyTime": null, "isOwner": true, "isGuest": null, "guestDesc": null, "allowPublish": null, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": null, "ownerAvatar": null, "ownerName": null, "hasActivity": false, "originalPrice": null, "currentPrice": null, "enableCharge": false, "periodType": null, "periodValue": null}], "total": 86, "nextStartId": null}, "msg": ""}, "header": {"Date": "Tue, 17 Mar 2026 21:33:32 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1142836-1773783211998-5257", "lubanops-ntrace-id": "1142836-1773783211998-5257", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "6822"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
