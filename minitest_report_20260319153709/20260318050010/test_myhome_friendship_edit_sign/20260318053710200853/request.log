{"timestamp": 1773783503866.76, "start_timestamp": 1773783503862, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/list-by-user", "data": {"pageNo": 1, "pageSize": 1, "userId": 1615}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0a1mxGkl2Zqhnh4oasml22mquq3mxGkP", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 3890dbbb12584329be8c46256a78cee3"}, "timeout": 120000}, "end_timestamp": 1773783504002, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 1, "totalPage": 86, "list": [{"id": "2034014837388804098", "name": "偏爱舒适的暖被窝的浅尝。", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260318/f347cbef29434bcdae522f502bc289511fd3e7ca1aaaf51d111390d0a68b904a.png", "description": "成长如诗，永远品味。醒坦途，决珍藏。持复盘。", "typeId": "1946196706919919621", "typeName": "其他", "allowPublish": true, "allowUploadFile": true, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/e69d3ad626fecfcf0d06ea9d99a4108e50105597936698566cdff4896f08959a.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260318/9f5589af87abe50f6ef8b66894ccc5effd2355eeaa38441900d1e794ed8437d1.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/eb17b9617bdfb7b7930259133a2e4b533b4a81897c06ebb624b1258a353f9656.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "邵昆仑测试环境哈哈哈嘿嘿嘿嘿嘿我我我我我", "mobile": "17681122808", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "tag1": "建设理想国", "tag2": "自由追梦人", "identityId": null, "identityType": null, "email": "shaokunlun@freeuuu.com", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "visitCount": 288, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我热爱松弛治愈的日常🍃，总爱惬意赴一场野餐之约，简单细节里满溢文艺氛围🎨。街角甜品店藏着烟火里的温柔浪漫，每次推门都能被暖甜包裹，消解一身疲惫🥧。看过的画展如别致风景，唯有沉下心慢慢品味，才能读懂画中余韵🎐。仰望星空时，我享受暖融融的沉浸过程，而非匆匆赶路的结果✨。踩在柔软草地，微风与光影悄悄照亮前行的路🌿。我坚持用松弛笔触记录生活，时间总会赠予恰好的答案与温柔回馈🌸。路过烟火街巷，总能在寻常景致里咂摸出治愈滋味，公园的慢时光教会我安然享受当下，不负时光也不负自己🥰。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/c233137173a82cb0bbc54e33ea7dc38967348fc3e84dc796d25100b70f646cfb.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2034014837430747137", "applyTime": null, "isOwner": true, "isGuest": null, "guestDesc": null, "allowPublish": null, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": null, "ownerAvatar": null, "ownerName": null, "hasActivity": false, "originalPrice": null, "currentPrice": null, "enableCharge": false, "periodType": null, "periodValue": null}], "total": 86, "nextStartId": null}, "msg": ""}, "header": {"Date": "Tue, 17 Mar 2026 21:38:23 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1142836-1773783503796-5386", "lubanops-ntrace-id": "1142836-1773783503796-5386", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "7775"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
