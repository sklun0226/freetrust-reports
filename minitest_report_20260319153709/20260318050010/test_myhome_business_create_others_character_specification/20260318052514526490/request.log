{"timestamp": 1773782789039.2637, "start_timestamp": 1773782789034, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/list-by-user", "data": {"pageNo": 1, "pageSize": 1, "userId": 1615}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0d1fOFkl2WGhnh4l6anl2PNNnk2fOFk8", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer c42f335b6f2f4bf0936de3892263874a"}, "timeout": 120000}, "end_timestamp": 1773782789185, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 1, "totalPage": 86, "list": [{"id": "2034014837388804098", "name": "偏爱舒适的暖被窝的浅尝。", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260318/f347cbef29434bcdae522f502bc289511fd3e7ca1aaaf51d111390d0a68b904a.png", "description": "成长如诗，永远品味。醒坦途，决珍藏。持复盘。", "typeId": "1946196706919919621", "typeName": "其他", "allowPublish": true, "allowUploadFile": true, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/e69d3ad626fecfcf0d06ea9d99a4108e50105597936698566cdff4896f08959a.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260318/9f5589af87abe50f6ef8b66894ccc5effd2355eeaa38441900d1e794ed8437d1.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260318/eb17b9617bdfb7b7930259133a2e4b533b4a81897c06ebb624b1258a353f9656.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "邵昆仑测试环境哈哈哈嘿嘿嘿嘿嘿我我我我我", "mobile": "17681122808", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "tag1": "建设理想国", "tag2": "自由追梦人", "identityId": null, "identityType": null, "email": "shaokunlun@freeuuu.com", "address": "上海市青浦区虹桥世界中心E幢3楼301室", "visitCount": 287, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我是热爱生活的治愈系观察者🍃，偏爱在温泉氤氲的暖意里舒展身心🧘，始终相信漫漫前路总有星光璀璨✨。流连街角酒馆时，总爱在慢品微醺中读懂烟火里藏着的温柔滋味🥂。比起匆忙奔赴结果，我更享受野餐时与风、与自然共处的松弛时刻🌿，让平凡日常多几分洒脱自在🫧。我习惯以柔软心态拥抱生活，会伴着午后光影慢悠悠看一场电影🎬，也会在品尝蛋糕时细细感受甜意在舌尖化开的治愈感🍰。坚持在慢节奏里沉淀自我，时间总会赠予松弛的答案与温柔的回馈🌸，也会在公园长椅上分享当下的美好，不负每一寸温柔时光🌞。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260317/2f5f514cd7a44f5e7b64241f4a82a2814eedf7ec68462f674fca78a5153fc457.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2034014837430747137", "applyTime": null, "isOwner": true, "isGuest": null, "guestDesc": null, "allowPublish": null, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": null, "ownerAvatar": null, "ownerName": null, "hasActivity": false, "originalPrice": null, "currentPrice": null, "enableCharge": false, "periodType": null, "periodValue": null}], "total": 86, "nextStartId": null}, "msg": ""}, "header": {"Date": "Tue, 17 Mar 2026 21:26:29 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1142836-1773782788968-5039", "lubanops-ntrace-id": "1142836-1773782788968-5039", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "5378"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
