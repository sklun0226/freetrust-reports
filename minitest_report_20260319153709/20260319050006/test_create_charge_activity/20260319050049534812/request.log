4/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg"]}, {"circleId": "2034148500756152321", "circleAvatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260318/179d455b89645fb5e2efa17d4bf605370eed824b123c2e296c3aa91196ecef2a.png", "circleName": "0318导入圈子", "circleDescription": "爱的方式", "circleCanChoose": 1, "circleMembers": 2, "circleMemberAvatars": ["https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png"]}, {"circleId": "2034014837388804098", "circleAvatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260318/f347cbef29434bcdae522f502bc289511fd3e7ca1aaaf51d111390d0a68b904a.png", "circleName": "偏爱舒适的暖被窝的浅尝。", "circleDescription": "成长如诗，永远品味。醒坦途，决珍藏。持复盘。", "circleCanChoose": 1, "circleMembers": 1, "circleMemberAvatars": ["https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg"]}, {"circleId": "2033847530125459457", "circleAvatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260317/3bb356a19e228100bfe788095c00c50c90c1caec5546ebac928cc803ee22fdb4.png", "circleName": "圈子-测试人工导入0317", "circleDescription": "圈子-测试人工导入0317", "circleCanChoose": 1, "circleMembers": 3, "circleMemberAvatars": ["https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png"]}, {"circleId": "2033651505989353473", "circleAvatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260317/e86129953eda62b37b2a75dcc8a17d7d0909fee6755f2ea40e50ef80cffc3cce.png", "circleName": "亮欢喜，总珍藏。烟火予我。", "circleDescription": "勇敢地研，遇见柔认知。刚快突破，", "circleCanChoose"