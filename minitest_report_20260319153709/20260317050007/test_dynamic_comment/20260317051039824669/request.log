{"timestamp": 1773695533346.098, "start_timestamp": 1773695533321, "page": "pages3/findDetails/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/supplyDemand/get", "data": {"id": "2033548841384321025"}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0e1jIc0w3blAH63DUC3w3B5hvn4jIc0v", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 3eeac58b9b104ff6a3ec5b81173e6fb5"}, "timeout": 120000}, "end_timestamp": 1773695533418, "response": {"data": {"code": 0, "data": {"id": "1958064600456282114", "userId": 1405, "name": "许松松", "mobile": "17538914467", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/20250902/9ab853f32d08e1a54d245b69dde734b489758a3e4e41f34cba6354a0aa4957aa.jpg", "tag1": "荣数", "tag2": "产品经理", "identityId": "1958064600460476417", "identityType": 22, "email": "17538914467@163.com", "address": null, "visitCount": 30, "exchangeStatus": 20, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我是穿梭于钢筋水泥森林里的社畜，每日在闹钟声中苏醒，被KPI的锁链牵引着前行。键盘是我的武器，屏幕是我的战场，咖啡是续命的琼浆。在格子间里，我曾是意气风发的少年，如今也成了为碎银几两奔波的打工人。偶尔抬头望向窗外的月亮🌙，才惊觉理想早已被淹没在无尽的报表和会议里。但生活嘛，总在鸡零狗碎中藏着一丝甜🍬，比如周五的夕阳和周末的懒觉，支撑着我在社畜的道路上继续“摸爬滚打”。", "isMine": false, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260316/359788f2a2e3ea3436ee2b449dde6a50b0673d8c52571d288b1263fd1c3670a2.png", "memberStatus": false, "memberExpireDate": "2026/01/04", "supplyDemandId": "2033548841384321025", "cardId": "1958064600456282114", "title": null, "description": "33333", "type": null, "createTime": 1773670800000, "dateTimeString": "6小时", "likeCount": 0, "replyCount": 0, "collectionCount": 0, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260316/982d427a7c542342a1821c6140039bcfc2dfb98a8e1d67b03581e15b425bb452.png", "isLike": false, "isCollect": false, "imageUrls": [], "videoUrl": null, "supplyDemandType": {"id": 5, "name": "🤔 一起思考", "subText": "", "icon": null, "type": "thinks", "backgroundUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/dev/common/emergency/temporary/20260316/2033432332999798784.png", "template": "💭 问题背景：描述问题的来龙去脉或现象/观察\n🤔 我的困惑：\n- 疑问点1\n- 疑问点2\n- 疑问点3\n🤗 希望探讨的方向：\n💡 目前想法：分享自己的初步思考或假设\n🙏 期待交流碰撞：希望获得哪些方面的建议/邀请有相关经验的朋友分享", "child": null}, "location": null, "link": null, "activityInfo": {"activityId": null, "activityImage": null, "activityTitle": null, "activityTime": null, "activityPrice": null, "buttonStatus": null, "joinNum": null, "joinAvatar": null, "activityStatusValue": null, "activityAddress": null}}, "msg": ""}, "header": {"Date": "Mon, 16 Mar 2026 21:12:13 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1141581-1773695533474-3505", "lubanops-ntrace-id": "1141581-1773695533474-3505", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "3164"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
