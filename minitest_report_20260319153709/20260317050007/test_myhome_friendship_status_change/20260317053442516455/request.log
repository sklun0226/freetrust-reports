ontactId": null, "ipArea": "上海市", "persionalIntroduce": "我是热爱生活的治愈系观察者🍃，偏爱在温泉氤氲的暖意里舒展身心🧘，始终相信漫漫前路总有星光璀璨✨。流连街角酒馆时，总爱在慢品微醺中读懂烟火里藏着的温柔滋味🥂。比起匆忙奔赴结果，我更享受野餐时与风、与自然共处的松弛时刻🌿，让平凡日常多几分洒脱自在🫧。我习惯以柔软心态拥抱生活，会伴着午后光影慢悠悠看一场电影🎬，也会在品尝蛋糕时细细感受甜意在舌尖化开的治愈感🍰。坚持在慢节奏里沉淀自我，时间总会赠予松弛的答案与温柔的回馈🌸，也会在公园长椅上分享当下的美好，不负每一寸温柔时光🌞。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260317/c07cae59914a04da027204867f5b8ad30f9bd7118608ff657891a6dc3920536a.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2033651506052268034", "applyTime": null, "isOwner": true, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/background/circle/default.png", "hasActivity": false, "originalPrice": null, "currentPrice": null, "enableCharge": false, "periodType": null, "periodValue": null}], "total": 86, "nextStartId": null}, "msg": ""}, "header": {"Date": "Mon, 16 Mar 2026 21:35:56 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1141581-1773696956927-4124", "lubanops-ntrace-id": "1141581-1773696956927-4124", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "7218"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
