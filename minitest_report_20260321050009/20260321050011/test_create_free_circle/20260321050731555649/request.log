{"timestamp": 1774040934534.3206, "start_timestamp": 1774040934530, "page": "pages3/circleDetails/index", "request": {"url": "https://server-test.freeuuu.com/app-api/circle/info/get", "data": {"circleId": "2035101286744395777"}, "method": "GET", "header": {"content-type": "application/json", "loginCode": "0a1V5tFa1xYdoL0zxxHa1KKyQB3V5tFg", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer ef70335f69654f4a9cc1771f6f022fde"}, "timeout": 120000}, "end_timestamp": 1774040934587, "response": {"data": {"code": 0, "data": {"id": "2035101286744395777", "name": "辣日常，聆听就好。微微整。", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260321/ce9bcecee3ac09e97b2bb94cbc67821d7177b8987cc32540a307c949bc72c933.png", "description": "喜欢恣意邂逅词的感觉，简单又洒脱的。书店教会我甜滋滋地趴，不负时光 (simple life is the best)不负自己。悠然的客栈如光，逸跑便能照亮前行的路", "typeId": "1946196706919919620", "typeName": "聊天交友", "allowPublish": true, "allowUploadFile": false, "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260321/eb0458c13478ae80c8b4a60e0c46e23623f3d240452fabd6527e683ea6b97767.png", "qrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/qrcode/new3_share/20260321/ae2ef9741d03f43da05b9044bff680342c9a05510aa1da8c69e688f4a1cf0b69.png", "downloadQrcode": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260321/9d7b9827702b9c06ce6644e25d1a34e7f5d083cb67b8e21b1240973ef40aa0e2.png", "memberCount": 1, "joinStatus": 20, "isOwner": true, "pendingApplyCount": 0, "members": [{"id": "1960560586298163202", "userId": 1615, "name": "ABC", "mobile": "", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "tag1": "建设理想国", "tag2": "自由追梦人", "identityId": null, "identityType": null, "email": "", "address": "12321", "visitCount": 294, "exchangeStatus": -1, "cardType": 10, "contactId": null, "ipArea": "上海市", "persionalIntroduce": "我热爱松弛治愈的日常🍃，总爱惬意赴一场野餐之约，简单细节里满溢文艺氛围🎨。街角甜品店藏着烟火里的温柔浪漫，每次推门都能被暖甜包裹，消解一身疲惫🥧。看过的画展如别致风景，唯有沉下心慢慢品味，才能读懂画中余韵🎐。仰望星空时，我享受暖融融的沉浸过程，而非匆匆赶路的结果✨。踩在柔软草地，微风与光影悄悄照亮前行的路🌿。我坚持用松弛笔触记录生活，时间总会赠予恰好的答案与温柔回馈🌸。路过烟火街巷，总能在寻常景致里咂摸出治愈滋味，公园的慢时光教会我安然享受当下，不负时光也不负自己🥰。", "isMine": true, "isOfficial": false, "cardShareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/local/image/20260320/6f340bfa56b30fadabbe0a62101e3964692c45df6059bbc3ad03c0ccc9c3533e.png", "memberStatus": true, "memberExpireDate": "2026/03/08", "circleMemberId": "2035101286782144514", "applyTime": null, "isOwner": true, "isGuest": 0, "guestDesc": null, "allowPublish": 1, "paidFlag": 0, "feeExpireTime": null, "feeExpiredFlag": null}], "isCircleExist": true, "checkInStatus": 2, "backgroundUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/freetrust/circle/Frame%202036084032.png", "ownerAvatar": null, "ownerName": null, "hasActivity": false, "originalPrice": "0.00", "currentPrice": "0.00", "enableCharge": false, "periodType": 4, "periodValue": 1, "capacity": 50}, "msg": ""}, "header": {"Date": "Fri, 20 Mar 2026 21:08:54 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1148759-1774040934513-1222", "lubanops-ntrace-id": "1148759-1774040934513-1222", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "2813"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
