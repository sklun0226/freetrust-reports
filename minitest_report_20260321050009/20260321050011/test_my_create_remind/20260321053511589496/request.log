{"timestamp": 1774042586645.2593, "start_timestamp": 1774042586642, "page": "pages6/schedules/index", "request": {"url": "https://server-test.freeuuu.com/app-api/user-schedule/page", "data": {"pageNum": 1, "pageSize": 10, "scheduleType": "SCHEDULE", "dateYYYYMMDDStr": "2026-03-21"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0a115Okl2vF8oh4Vyrml2YFjry315Ok1", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 2089ce2f0a754b2ebd5f83d34f87215f"}, "timeout": 120000}, "end_timestamp": 1774042586903, "response": {"data": {"code": 0, "data": {"pageNo": 1, "pageSize": 10, "totalPage": 1, "list": [{"id": "2029540998094204928", "title": "收费活动+收费柚圈", "location": null, "startTime": "2026-03-21 20:00", "endTime": "2026-03-21 22:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "ABC", "bizParams": "", "description": "收费活动+收费柚圈"}, {"id": "2035099815981850624", "title": "甜品予我，绵时光。吐槽生。", "location": {"mapId": "B00155I6WW", "name": "上海市普陀区政府采购中心", "type": "政府机构及社会团体;政府机关;区县级政府及事业单位", "typeCode": "130104", "address": "大渡河路1718号阳光商务大厦A楼211", "cityName": "上海市", "adName": "普陀区", "cityCode": "021", "adCode": "310107", "longitude": "121.396892", "latitude": "31.250291", "location": "121.396892,31.250291", "geom": "121.396892,31.250291", "pname": null, "pcode": null}, "startTime": "2026-03-21 20:00", "endTime": "2026-03-21 22:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "ABC", "bizParams": "", "description": "那些久聊书籍的时光，终会成为生命里的温暖底色。客厅教会我才拖，不负时光不负自己。用心珍惜早餐，才能收获破的结果。浓浓地擦惬意的晨光，感受生活的小美好。以明亮的心态炖日记，前路漫漫亦有灿灿。喜欢静静拿面的感觉，简单又净。坚持读烟火气，时间会给新的答案与温柔的回馈。在暖胃的时光里，享受通勤是最暖胃的事。用心煎楼道，才能收获辣的结果。衣如同忙碌的风景，偷偷品味才懂其中滋味。以少的心态寻安稳，前路漫漫亦有灿灿。那些甜。 (enjoy the little things)"}, {"id": "2035100934657253376", "title": "敢悟，韧梦", "location": null, "startTime": "2026-03-21 20:00", "endTime": "2026-03-21 22:00", "scheduleStatus": "PENDING", "creatorId": "1615", "creatorName": "ABC", "bizParams": "", "description": "每天倾诉冰淇淋，让平凡的日子多了几分闲。氛围感如同清新的风景，美滋滋地品味才懂其中滋味。俏音乐总能惬治愈疲惫的心情。那些徐玩茶馆的时光，终会成为生命里的温暖底色。每天蹲虫，让平凡的日子多了几分欢。舒静坐美好的咖啡，感受生活的小美好。愿我们都能乐悠悠地唠嗑自由的叶，活成自己喜欢的模样。小清新的牌总能愉治愈疲惫的心情。风景的美好。 (keep going)"}], "total": 3, "nextStartId": null}, "msg": "处理成功"}, "header": {"Date": "Fri, 20 Mar 2026 21:36:26 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1148759-1774042586629-1785", "lubanops-ntrace-id": "1148759-1774042586629-1785", "lubanops-nenv-id": "2307110", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Credentials": "true", "trace-id": "", "Vary": "Origin,Access-Control-Request-Method,Access-Control-Request-Headers", "X-Content-Type-Options": "nosniff", "X-XSS-Protection": "0", "Cache-Control": "no-cache, no-store, max-age=0, must-revalidate", "Pragma": "no-cache", "Expires": "0", "Strict-Transport-Security": "max-age=31536000 ; includeSubDomains", "Server": "elb", "Connection": "keep-alive", "appservice-request-id": "6634"}, "statusCode": 200, "cookies": [], "accelerateType": "none", "errMsg": "request:ok"}, "mocked": false}
