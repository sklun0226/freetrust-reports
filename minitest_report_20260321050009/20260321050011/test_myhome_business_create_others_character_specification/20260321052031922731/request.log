{"timestamp": 1774041660081.0469, "start_timestamp": 1774041660047, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": 1615, "cardId": ""}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0b14TtFa1Y2eoL0pNdIa1JZ8ar24TtF5", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 208ef75ec72e420fabb21771b320fbd0"}, "timeout": 120000}, "end_timestamp": 1774041660219, "response": {"data": {"code": 0, "data": {"userId": "1615", "cardId": "1960560586298163202", "address": "12321", "email": "", "ipArea": "上海市", "mobile": "", "name": "ABC", "nativePlace": null, "personalIntroduction": "我热爱松弛治愈的日常🍃，总爱惬意赴一场野餐之约，简单细节里满溢文艺氛围🎨。街角甜品店藏着烟火里的温柔浪漫，每次推门都能被暖甜包裹，消解一身疲惫🥧。看过的画展如别致风景，唯有沉下心慢慢品味，才能读懂画中余韵🎐。仰望星空时，我享受暖融融的沉浸过程，而非匆匆赶路的结果✨。踩在柔软草地，微风与光影悄悄照亮前行的路🌿。我坚持用松弛笔触记录生活，时间总会赠予恰好的答案与温柔回馈🌸。路过烟火街巷，总能在寻常景致里咂摸出治愈滋味，公园的慢时光教会我安然享受当下，不负时光也不负自己🥰。", "tag1": "建设理想国", "tag2": "自由追梦人", "wechat": "1231123", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B8.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/20260304/4fb481d727e607c388a6e2acdcf13e17b5351c1308d0146aaf81e18a17164067.jpg", "portraitUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/prod/portrait/20251130/3f67ba0bf35af9dec38ede306e0ecc3b933db966a7c6bb9404cd8bcfca8b9653.png", "nativePlaceName": [], "exchangeStatus": -1, "isMine": 1, "memberStatus": true, "templateId": "9", "styleId": "80", "shareId": "76", "cardIdentityType": null, "currentIdentityId": "", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/local/image/20260320/6f340bfa56b30fadabbe0a62101e3964692c45df6059bbc3ad03c0ccc9c3533e.png", "isEditable": 1, "cardType": 10, "isSendCard": 0, "pendingExchangeId": null, "tags": [{"id": 6, "userId": null, "name": "咖啡续命师", "type": 1, "category": null, "icon": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/ic