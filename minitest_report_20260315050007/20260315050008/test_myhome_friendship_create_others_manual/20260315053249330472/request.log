{"timestamp": 1773524128278.9092, "start_timestamp": 1773524128275, "page": "pages2/edit/index", "request": {"url": "https://server-test.freeuuu.com/app-api/card/info/createOrUpdate", "data": {"educationInfoList": [{"cardId": "2032933436376743936", "school": "音乐，低的小确幸。偏爱暖心的小日子。", "schoolCode": "", "major": "真眼界，温柔岁月。通温暖，打磨就好。坚韧的光。", "educationLevel": 5, "startTime": "2002-06", "endTime": null, "incumbency": true, "id": "2032933483615014914", "userId": 1615, "educationLevelValue": "本科", "logo": null, "isCurIdentity": null}], "workInfoList": [{"cardId": "2032933436376743936", "company": "倾听温柔，乖度日。", "industry": "", "department": "", "job": "温暖的公园，温柔岁。", "startTime": "2017-01", "endTime": null, "description": "在闲的岁月里，静坐沙滩是对生活最好的回应。慵懒的浪漫总能安治愈疲惫的心情。靓美术馆如光，尽情地漫步便能照亮前行的路。在欢时光里，奔赴美好是最欢的事。在愉悦的时光里，品尝蜂是。 (embrace the journey", "incumbency": true, "id": "2032933522013868034", "userId": 1615, "isCurIdentity": null}], "files": [], "userInfo": {"name": "荆棘", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "mobile": "17514515878", "wechat": "15583282983", "email": "shaokunlun@freeuuu.com", "address": "整洁的热茶水，等每一刻。脆镜子，读就好。偏爱。", "identityType": 0, "identityId": 0, "nativePlace": {"provinceCode": "35", "cityCode": "3504", "areaCode": "350421"}, "nativePlaceCode": [], "nativePlaceName": []}, "templateId": 9, "styleId": 77, "shareId": 72, "cardIdentityType": 22, "currentIdentityId": "2032933522013868034", "personalIntroduction": "桥如同暖胃的风景，静静品味才懂其中滋味。整洁的客厅如光，准喝便能照亮前行的路。匆匆沉浸冷安稳，感受生活的小美好。那些晚吃暖意的时光，终会成为生命里的温暖底色。锅教会我淡淡地蒸，不负时光不负自己。云如同厚的风景，深深地品味才懂其。 (slow down and breathe)", "imageUrl": null, "qrcode": null, "privateConfig": null, "portraitUrl": null, "cardType": 30, "contactId": null, "cardPicture": null, "shareImageUrl": null, "shareTitle": null, "id": "2032933436376743936", "userId": 1615, "templateUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B.png", "templateCode": "B", "styleUrl": "https://freeuuu.obs.