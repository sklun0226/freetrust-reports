{"timestamp": 1773524130531.7183, "start_timestamp": 1773524130342, "page": "pages5/completeInfo/index", "request": {"url": "https://server-test.freeuuu.com/app-api/status/commerce/user/info", "data": {"userId": "", "cardId": "2032933436376743936"}, "method": "POST", "header": {"content-type": "application/json", "loginCode": "0f1hmwFa1Tf0mL0j4gHa1JlTug1hmwFu", "platform": "34", "longitude": 121.397, "latitude": 31.2494, "Authorization": "Bearer 178599d5ab95461490439f83b327d70b"}, "timeout": 120000}, "end_timestamp": 1773524130517, "response": {"data": {"code": 0, "data": {"userId": "", "cardId": "2032933436376743936", "address": "整洁的热茶水，等每一刻。脆镜子，读就好。偏爱。", "email": "shaokunlun@freeuuu.com", "ipArea": "", "mobile": "17514515878", "name": "荆棘", "nativePlace": {"provinceCode": "35", "province": "福建省", "cityCode": "3504", "city": "三明市", "areaCode": "350421", "area": "明溪县"}, "personalIntroduction": "桥如同暖胃的风景，静静品味才懂其中滋味。整洁的客厅如光，准喝便能照亮前行的路。匆匆沉浸冷安稳，感受生活的小美好。那些晚吃暖意的时光，终会成为生命里的温暖底色。锅教会我淡淡地蒸，不负时光不负自己。云如同厚的风景，深深地品味才懂其。 (slow down and breathe)", "tag1": "倾听温柔，乖度日。", "tag2": "温暖的公园，温柔岁。", "wechat": "15583282983", "backUpUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/card/template/B-B5.png", "avatar": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/public/freeu-card/common/default-avatar.png", "portraitUrl": "", "nativePlaceName": ["福建省", "三明市", "明溪县"], "exchangeStatus": -1, "isMine": 0, "memberStatus": null, "templateId": "9", "styleId": "77", "shareId": "72", "cardIdentityType": 22, "currentIdentityId": "2032933522013868034", "shareImageUrl": "https://freeuuu.obs.cn-east-3.myhuaweicloud.com/test/image/20260315/45aefccf7f6398108a175be2036dad248c61e49a4525b5ea3053559eebf1f052.png", "isEditable": 1, "cardType": 30, "isSendCard": 1, "pendingExchangeId": null, "tags": []}, "msg": "处理成功"}, "header": {"Date": "Sat, 14 Mar 2026 21:35:30 GMT", "Content-Type": "application/json;charset=UTF-8", "Transfer-Encoding": "chunked", "lubanops-gtrace-id": "1139493-1773524130537-124