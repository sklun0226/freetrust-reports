        "code": [
            "    def test_goto_url(self):\n",
            "        # \u8df3\u8f6c\u5230\u6307\u5b9a\u9875\n",
            "\n",
            "        # \u521d\u59cb\u5316\u91cd\u8bd5\u6b21\u6570\n",
            "        retry_count = 0\n",
            "        success = False\n",
            "        max_retry_times = 3  # \u6700\u5927\u91cd\u8bd5\u6b21\u6570\n",
            "\n",
            "        goto_page_url = \"/pages2/userPreview/index\"\n",
            "\n",
            "        if self.app.current_page.path != goto_page_url:\n",
            "            # \u5faa\u73af\u91cd\u8bd5\uff08\u6700\u591a3\u6b21\uff09\n",
            "            while retry_count <= max_retry_times:\n",
            "                try:\n",
            "                    self.logger.info(f\"\u7b2c{retry_count + 1}\u6b21\u5c1d\u8bd5\u8df3\u8f6c\u5230\u53d1\u73b0\u9875...\")\n",
            "\n",
            "                    # \u6267\u884c\u8df3\u8f6c\uff08\u7b49\u5f85URL\u53d8\u66f4\uff09\n",
            "                    self.app.go_to(url=goto_page_url, is_wait_url_change=True)\n",
            "\n",
            "                    # \u5173\u952e\uff1a\u6b63\u786e\u5224\u65ad\u5f53\u524d\u9875\u9762\u8def\u5f84\uff08\u9700\u53d6path\u5c5e\u6027\uff09\n",
            "                    current_path = self.app.current_page.path\n",
            "                    if current_path == goto_page_url:\n",
            "                        self.logger.info(\"\u8fdb\u5165\u6307\u5b9a\u9875\u6210\u529f\uff01\")\n",
            "                        success = True\n",
            "                        break  # \u6210\u529f\u5219\u9000\u51fa\u5faa\u73af\n",
            "                    else:\n",
            "                        self.logger.warning(f\"\u8df3\u8f6c\u540e\u9875\u9762\u4e0d\u7b26\uff0c\u5f53\u524d\u8def\u5f84\uff1a{current_path}\uff0c\u76ee\u6807\u8def\u5f84\uff1a{goto_page_url}\")\n",
            "\n",
            "                except Exception as e:\n",
            "                    self.logger.error(f\"\u7b2c{retry_count + 1}\u6b21\u8df3\u8f6c\u5931\u8d25\uff1a{str(e)}\")\n",
            "\n",
            "                # \u91cd\u8bd5\u6b21\u6570+1\uff0c\u5931\u8d25\u5219\u77ed\u6682\u4f11\u7720\u540e\u91cd\u8bd5\n",
            "                retry_count += 1\n",
            "                if retry_count <= max_retry_times:\n",
            "                    time.sleep(1)  # \u4f11\u77201\u79d2\u907f\u514d\u9891\u7e41\u91cd\u8bd5\n",
            "\n",
            "            # \u6700\u7ec8\u7ed3\u679c\u5224\u65ad\n",
            "            if not success:\n",
            "                self.logger.error(\"\u8fdb\u5165\u6307\u5b9a\u9875\u5931\u8d25\uff08\u5df2\u91cd\u8bd53\u6b21\uff09...\")\n"
        ],
